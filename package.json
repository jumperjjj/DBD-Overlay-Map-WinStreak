{
  "name": "dbd-overlay-studio",
  "version": "2.5.2-beta.1",
  "description": "DBD WinStreak + Match Overlay Studio",
  "main": "main.js",
  "author": "SA Ranked",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.saranked.dbdoverlaymapwinstreak",
    "productName": "DBD Overlay Studio",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "app.html",
      "streak.html",
      "match.html",
      "obs.html",
      "obs-streak.html",
      "obs-match.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DBD-Overlay-Studio-Beta-2.5.2-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "productName": "DBD Overlay Studio"
}