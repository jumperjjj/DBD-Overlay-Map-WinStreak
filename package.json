{
  "name": "dbd-overlay-map-winstreak",
  "version": "1.0.2-beta.1",
  "description": "DBD Overlay Map & WinStreak - log format diagnostic beta",
  "main": "main.js",
  "author": "SA Ranked",
  "license": "MIT",
  "scripts": {"start":"electron .","dist":"electron-builder --win nsis"},
  "devDependencies":{"electron":"^38.0.0","electron-builder":"^26.0.12"},
  "build":{
    "appId":"com.saranked.dbdoverlaymapwinstreak",
    "productName":"DBD Overlay Map & WinStreak",
    "files":["main.js","preload.js","index.html"],
    "win":{"target":[{"target":"nsis","arch":["x64"]}],"artifactName":"DBD-Overlay-Map-WinStreak-Beta-1.0.2-${arch}.${ext}"},
    "nsis":{"oneClick":true,"perMachine":false,"allowElevation":true,"createDesktopShortcut":true,"createStartMenuShortcut":true}
  }
}